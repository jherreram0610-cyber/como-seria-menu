# Llaves de Bold (Pagos en línea) — pedirlas al administrador de la cuenta Bold de Como Sería.
# Empezar siempre con las de sandbox (pruebas) antes de pasar a producción.
# NOTA: Bold no está activo todavía, estas llaves no se usan en ningún flujo por ahora.

# Llave secreta: SOLO se usa en /api, nunca debe llegar al frontend ni al repo.
BOLD_SECRET_KEY=

# Llave de identidad: se usa en /api para consultar el estado de la transacción,
# y también es la que va en el frontend como data-api-key del Botón de pagos.
BOLD_IDENTITY_KEY=

# ─── Base de datos (Postgres) ────────────────────────────────────────────────
# Local con Docker: postgres://postgres:postgres@localhost:5432/comoseria
# Producción (Supabase): usar el connection string "pooled" (puerto 6543)
DATABASE_URL=

# ─── Panel de administración ─────────────────────────────────────────────────
# Contraseña compartida para entrar a /admin (reemplaza el PIN anterior).
ADMIN_PASSWORD=

# Secreto usado para firmar la cookie de sesión del panel. Cualquier string largo y aleatorio.
ADMIN_SESSION_SECRET=
